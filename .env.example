# Firebase project settings (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Cloudinary → Settings → Upload → Upload presets (unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=replace-me
VITE_CLOUDINARY_UPLOAD_PRESET=replace-me

# GitHub Pages project path, e.g. /perfect-flashcards/ (use / for local/custom domain)
VITE_BASE_PATH=/
